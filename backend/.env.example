SECRET_KEY=
DEBUG=1
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=

DB_ENGINE=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# 1 = permite MariaDB abaixo de 10.5 (ex.: 10.2 corporativo). Preferir upgrade do servidor.
DB_ALLOW_LEGACY_MARIADB=


# Credenciais Oracle: pasta conf/ na raiz do monorepo (chave.key + erp.dat)
# Alternativa: caminho absoluto da conf
RASTROGLOBUS_CONF_DIR=

# Instant Client (thick). Preferivel: conf/oracle_client_dir.txt
ORACLE_CLIENT_LIB_DIR=
GLOBUS_CALL_TIMEOUT_MS=60000
GLOBUS_GRUPOS_PECAS=01

# OCR DANFE por foto (OpenAI Vision) — sem chave = endpoint retorna 503
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
