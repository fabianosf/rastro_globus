# Copie para .env na raiz (usado pelo docker compose). NÃO versionar .env.

SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=0
ALLOWED_HOSTS=srv-af-des01,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://srv-af-des01:8888,http://srv-af-des01

DB_NAME=sggi
DB_USER=sggi
DB_PASSWORD=troque-senha-db
DB_ROOT_PASSWORD=troque-senha-root

# Opcional: OCR DANFE
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Globus / Oracle (fora de escopo do login LDAP; opcional legado)
RASTROGLOBUS_CONF_DIR=
ORACLE_CLIENT_LIB_DIR=
GLOBUS_CALL_TIMEOUT_MS=60000
GLOBUS_GRUPOS_PECAS=01

# Samba / AD LDAPS — autenticação apenas (não altera o diretório)
# Rede no srv-af-des01 já valida 636; ligar só após CA + conta de serviço.
AD_LDAP_ENABLED=0
AD_LDAP_URI=ldaps://srv-rd-ucs01.grbf.dom:636
AD_LDAP_URI_FAILOVER=ldaps://srv-rd-ucs02.grbf.dom:636
AD_LDAP_BASE_DN=DC=grbf,DC=dom
AD_LDAP_BIND_DN=
AD_LDAP_BIND_PASSWORD=
AD_LDAP_USER_FILTER=(sAMAccountName=%(user)s)
AD_LDAP_CA_CERT_PATH=/certs/ucs-ca.crt
AD_LDAP_REQUIRE_CERT=demand
AD_DOMAIN=grbf.dom
